<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Delta ETH Strategy Dashboard - Live Ready</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chart.js/4.4.1/chart.umd.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Space+Grotesk:wght@500;600&amp;display=swap');
        :root { --tw-color-primary: #00ff9d; }
        body { font-family: 'Inter', system_ui, sans-serif; }
        .header-font { font-family: 'Space Grotesk', sans-serif; }
        .glass { background: rgba(255,255,255,0.08); backdrop-filter: blur(12px); }
        .live-dot { animation: pulse 2s infinite; }
    </style>
</head>
<body class="bg-zinc-950 text-white min-h-screen">
    <div class="max-w-screen-2xl mx-auto">
        <!-- HEADER -->
        <div class="border-b border-white/10 bg-black/80 sticky top-0 z-50">
            <div class="px-8 py-5 flex items-center justify-between">
                <div class="flex items-center gap-x-3">
                    <div class="w-9 h-9 bg-emerald-500 rounded-2xl flex items-center justify-center text-xl">Δ</div>
                    <h1 class="header-font text-3xl tracking-tighter">ETH STRATEGY DASHBOARD</h1>
                    <span class="px-3 py-1 text-xs font-mono bg-emerald-500/20 text-emerald-400 rounded-3xl flex items-center gap-x-1">
                        <span class="w-2 h-2 bg-emerald-400 rounded-full live-dot"></span>
                        LIVE • Delta India
                    </span>
                </div>
                
                <div class="flex items-center gap-x-8">
                    <!-- Connection Status -->
                    <div id="ws-status" class="flex items-center gap-x-2 text-sm font-medium">
                        <span class="px-3 py-1 bg-zinc-900 rounded-3xl flex items-center gap-x-1">
                            <i class="fa-solid fa-circle text-red-500"></i>
                            Disconnected
                        </span>
                    </div>

                    <!-- Account Info -->
                    <div class="flex items-center gap-x-6 text-sm">
                        <div>
                            <span class="text-zinc-400">Balance (USDT)</span>
                            <div id="balance-usdt" class="font-mono text-xl font-semibold text-emerald-400">0.00</div>
                        </div>
                        <div>
                            <span class="text-zinc-400">Position</span>
                            <div id="position-size" class="font-mono text-xl font-semibold">0 ETH</div>
                        </div>
                        <div>
                            <span class="text-zinc-400">Unrealized PnL</span>
                            <div id="unreal-pnl" class="font-mono text-xl font-semibold text-emerald-400">+0.00</div>
                        </div>
                    </div>

                    <!-- API Config -->
                    <div onclick="showApiModal()" class="cursor-pointer flex items-center gap-x-2 px-4 py-2 bg-white/5 hover:bg-white/10 rounded-3xl text-sm">
                        <i class="fa-solid fa-key"></i>
                        <span id="api-config-status" class="font-medium">Configure API Keys</span>
                    </div>

                    <!-- Risk Settings -->
                    <div class="flex items-center gap-x-2 text-xs font-mono bg-white/5 px-4 h-9 rounded-3xl">
                        Risk per trade: 
                        <input id="risk-percent" type="text" value="0.5" class="w-10 bg-transparent text-center focus:outline-none font-bold">%
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-12 gap-6 p-8">
            
            <!-- LEFT COLUMN: MARKET STATE + CHARTS -->
            <div class="col-span-8 space-y-6">

                <!-- Price Header -->
                <div class="glass border border-white/10 rounded-3xl p-6">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="flex items-baseline gap-x-3">
                                <span id="symbol" class="text-5xl font-semibold header-font">ETHUSD</span>
                                <span id="current-price" class="text-6xl font-mono font-bold text-white">0.00</span>
                            </div>
                            <div id="price-change" class="flex items-center gap-x-2 text-xl">
                                <!-- filled by JS -->
                            </div>
                        </div>
                        
                        <div class="text-right">
                            <div class="flex gap-x-8 text-sm">
                                <div>
                                    <div class="text-zinc-400 text-xs">Mark Price</div>
                                    <div id="mark-price" class="font-mono text-2xl">0.00</div>
                                </div>
                                <div>
                                    <div class="text-zinc-400 text-xs">24h Vol</div>
                                    <div id="volume-24h" class="font-mono text-2xl">0</div>
                                </div>
                                <div>
                                    <div class="text-zinc-400 text-xs">Funding</div>
                                    <div id="funding-rate" class="font-mono text-2xl text-amber-400">0.0000%</div>
                                </div>
                            </div>
                            
                            <!-- Strategy State -->
                            <div id="market-state" class="mt-4 inline-flex items-center gap-x-2 px-6 py-2 bg-zinc-900 rounded-3xl text-sm font-medium">
                                <i class="fa-solid fa-circle"></i>
                                <span id="state-text">BALANCE • Waiting for displacement</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Chart Area (Price + CVD) -->
                <div class="glass border border-white/10 rounded-3xl p-6 h-96 flex">
                    <div class="flex-1">
                        <div class="flex justify-between mb-4">
                            <h2 class="text-lg font-semibold">Price + Cumulative Volume Delta (CVD)</h2>
                            <div class="flex text-xs gap-x-4">
                                <button onclick="resetCVD()" class="px-3 py-1 bg-white/10 hover:bg-white/20 rounded-2xl">Reset CVD</button>
                                <select id="timeframe" onchange="changeTimeframe()" class="bg-white/10 rounded-2xl px-3 text-xs">
                                    <option value="1m">1m</option>
                                    <option value="5m" selected>5m</option>
                                    <option value="15m">15m</option>
                                </select>
                            </div>
                        </div>
                        <canvas id="priceCVDChart" class="w-full h-80"></canvas>
                    </div>
                </div>

                <!-- Volume Profile + Order Flow -->
                <div class="grid grid-cols-2 gap-6">
                    <!-- Volume Profile -->
                    <div class="glass border border-white/10 rounded-3xl p-6">
                        <div class="flex justify-between mb-4">
                            <h2 class="text-lg font-semibold flex items-center gap-x-2">
                                <i class="fa-solid fa-chart-bar"></i>
                                VOLUME PROFILE (Impulse Leg)
                            </h2>
                            <button onclick="resetVP()" class="text-xs px-4 py-1 bg-emerald-500/20 text-emerald-400 rounded-3xl">Reset VP</button>
                        </div>
                        <canvas id="volumeProfileChart" class="w-full h-64"></canvas>
                        <div id="vp-levels" class="mt-4 text-xs font-mono grid grid-cols-3 gap-2"></div>
                    </div>

                    <!-- Live Order Flow -->
                    <div class="glass border border-white/10 rounded-3xl p-6">
                        <h2 class="text-lg font-semibold mb-4 flex items-center gap-x-2">
                            <i class="fa-solid fa-bolt"></i>
                            ORDER FLOW • Aggression
                        </h2>
                        <div id="order-flow-list" class="h-64 overflow-auto font-mono text-xs space-y-1"></div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: CONTROLS + EXECUTION -->
            <div class="col-span-4 space-y-6">

                <!-- L2 Orderbook -->
                <div class="glass border border-white/10 rounded-3xl p-6">
                    <h2 class="text-lg font-semibold mb-4">LIVE ORDER BOOK</h2>
                    <div class="grid grid-cols-2 gap-6 text-sm font-mono">
                        <div>
                            <div class="text-emerald-400 text-xs mb-2">BIDS</div>
                            <div id="bids" class="space-y-px text-xs"></div>
                        </div>
                        <div>
                            <div class="text-red-400 text-xs mb-2">ASKS</div>
                            <div id="asks" class="space-y-px text-xs"></div>
                        </div>
                    </div>
                </div>

                <!-- Strategy Playbook Quick View -->
                <div class="glass border border-white/10 rounded-3xl p-6 text-xs">
                    <h3 class="font-semibold mb-3 text-emerald-400">CURRENT SETUP DETECTION</h3>
                    <div id="setup-status" class="space-y-3">
                        <!-- JS injected cards for Trend / Mean-Reversion -->
                    </div>
                    <div class="mt-6 pt-4 border-t border-white/10 text-[10px] text-zinc-400">
                        Trend Model: Out-of-balance + LVN + aggression<br>
                        Mean Reversion: Failed breakout + reclaim + aggression
                    </div>
                </div>

                <!-- TRADE EXECUTION PANEL (LIVE MONEY READY) -->
                <div class="glass border border-emerald-400/30 rounded-3xl p-6 bg-gradient-to-br from-emerald-500/5 to-transparent">
                    <h2 class="text-xl font-semibold mb-4 flex items-center gap-x-2">
                        <i class="fa-solid fa-paper-plane"></i>
                        LIVE TRADE EXECUTION
                    </h2>
                    
                    <div class="flex gap-3 mb-4">
                        <button onclick="executeTrade('buy')" 
                                class="flex-1 py-4 bg-emerald-500 hover:bg-emerald-600 rounded-3xl text-xl font-semibold text-black flex items-center justify-center gap-x-2">
                            <i class="fa-solid fa-arrow-trend-up"></i> LONG
                        </button>
                        <button onclick="executeTrade('sell')" 
                                class="flex-1 py-4 bg-red-500 hover:bg-red-600 rounded-3xl text-xl font-semibold text-black flex items-center justify-center gap-x-2">
                            <i class="fa-solid fa-arrow-trend-down"></i> SHORT
                        </button>
                    </div>

                    <div class="grid grid-cols-2 gap-4 text-xs">
                        <div>
                            <label class="block text-zinc-400 mb-1">Order Type</label>
                            <select id="order-type" class="w-full bg-white/10 rounded-2xl p-3 text-white">
                                <option value="market">MARKET (instant)</option>
                                <option value="limit">LIMIT (at LVN)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-zinc-400 mb-1">Size (ETH)</label>
                            <input id="trade-size" type="text" value="0.1" 
                                   class="w-full bg-white/10 rounded-2xl p-3 font-mono text-center">
                        </div>
                    </div>

                    <div id="risk-calc" class="mt-4 text-xs bg-black/40 rounded-2xl p-3 font-mono">
                        Risk: <span id="calc-risk">0.00 USDT</span> • Est. R:R 1:3.8
                    </div>

                    <div onclick="confirmAndPlaceOrder()" 
                         class="mt-6 cursor-pointer text-center py-4 bg-white text-black rounded-3xl font-semibold text-lg flex items-center justify-center gap-x-2 hover:scale-105 transition">
                        <i class="fa-solid fa-check"></i>
                        PLACE ORDER • LIVE ACCOUNT
                    </div>
                    <p class="text-[10px] text-center mt-3 text-amber-400">0.25–0.5% account risk enforced • Stop beyond aggression print</p>
                </div>

                <!-- Recent Alerts -->
                <div class="glass border border-white/10 rounded-3xl p-4 text-xs max-h-48 overflow-auto" id="alert-log">
                    <div class="font-semibold mb-2 sticky top-0 bg-zinc-900 py-1">ALERT LOG</div>
                </div>
            </div>
        </div>
    </div>

    <!-- API Modal -->
    <div onclick="if(event.target.id==='api-modal')hideApiModal()" id="api-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-[9999]">
        <div onclick="event.stopImmediatePropagation()" class="bg-zinc-900 rounded-3xl max-w-lg w-full mx-4 p-8">
            <h2 class="text-2xl font-semibold mb-6">Delta India API Configuration</h2>
            
            <div class="space-y-6">
                <div>
                    <label class="text-xs uppercase tracking-widest text-zinc-400 mb-2 block">API Key</label>
                    <input id="api-key-input" type="text" placeholder="your_api_key_here" 
                           class="w-full bg-white/10 rounded-2xl px-5 py-4 font-mono text-sm">
                </div>
                <div>
                    <label class="text-xs uppercase tracking-widest text-zinc-400 mb-2 block">API Secret</label>
                    <input id="api-secret-input" type="password" placeholder="your_api_secret_here" 
                           class="w-full bg-white/10 rounded-2xl px-5 py-4 font-mono text-sm">
                </div>
                <div class="flex gap-x-3">
                    <button onclick="saveApiKeys()" 
                            class="flex-1 py-4 bg-emerald-500 text-black rounded-3xl font-semibold">Save & Connect</button>
                    <button onclick="hideApiModal()" 
                            class="flex-1 py-4 bg-white/10 rounded-3xl font-semibold">Cancel</button>
                </div>
                <p class="text-xs text-zinc-400">Keys are stored only in browser localStorage. Never share. IP must be whitelisted in Delta dashboard.</p>
            </div>
        </div>
    </div>

    <script>
        // ==================== CONFIG & GLOBALS ====================
        let API_KEY = localStorage.getItem('deltaApiKey') || '';
        let API_SECRET = localStorage.getItem('deltaApiSecret') || '';
        let WS = null;
        let symbol = 'ETHUSD';
        let productId = 3136; // Confirmed ETHUSD perpetual on Delta India
        
        // Real-time data stores
        let currentPrice = 0;
        let markPrice = 0;
        let lastPrice = 0;
        let priceHistory = [];      // {t: timestamp, p: price}
        let cvd = 0;                // Cumulative Volume Delta
        let cvdHistory = [];
        let tradesBuffer = [];      // last 200 trades for order flow
        let volumeProfile = new Map(); // price → volume
        let bids = [];
        let asks = [];
        let position = { size: 0, side: null, entry: 0 };
        
        let priceChartInstance = null;
        let vpChartInstance = null;
        
        const RISK_PERCENT = 0.5; // default
        
        // ==================== WEBSOCKET CONNECTION ====================
        function connectWebSocket() {
            const wsUrl = 'wss://socket.india.delta.exchange';
            WS = new WebSocket(wsUrl);
            
            WS.onopen = () => {
                document.getElementById('ws-status').innerHTML = `
                    <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 rounded-3xl flex items-center gap-x-1">
                        <span class="w-2 h-2 bg-emerald-400 rounded-full live-dot"></span>
                        CONNECTED • ${symbol}
                    </span>`;
                
                // Subscribe to everything we need for the strategy
                const subscribeMsg = {
                    "type": "subscribe",
                    "payload": {
                        "channels": [
                            { "name": "v2/ticker", "symbols": [symbol] },
                            { "name": "all_trades", "symbols": [symbol] },
                            { "name": "l2_orderbook", "symbols": [symbol] },
                            { "name": "mark_price", "symbols": [symbol] },
                            { "name": "funding_rate", "symbols": [symbol] }
                        ]
                    }
                };
                WS.send(JSON.stringify(subscribeMsg));
                
                // If API keys exist → authenticate private channels
                if (API_KEY && API_SECRET) {
                    authenticatePrivate();
                }
            };
            
            WS.onmessage = (event) => {
                const data = JSON.parse(event.data);
                handleWebSocketMessage(data);
            };
            
            WS.onerror = (err) => console.error('WS Error:', err);
            WS.onclose = () => {
                document.getElementById('ws-status').innerHTML = `<span class="px-3 py-1 bg-red-500/20 text-red-400 rounded-3xl">Disconnected • Reconnecting...</span>`;
                setTimeout(connectWebSocket, 3000);
            };
        }
        
        function authenticatePrivate() {
            if (!API_SECRET) return;
            const ts = Math.floor(Date.now() / 1000);
            const signature = CryptoJS.HmacSHA256(`GET${ts}/live`, API_SECRET).toString(CryptoJS.enc.Hex);
            
            const authMsg = {
                "type": "key-auth",
                "payload": {
                    "api-key": API_KEY,
                    "timestamp": ts,
                    "signature": signature
                }
            };
            WS.send(JSON.stringify(authMsg));
            
            // Also subscribe to private channels for position & balance
            setTimeout(() => {
                const privateSub = {
                    "type": "subscribe",
                    "payload": { "channels": [{ "name": "positions" }, { "name": "margins" }] }
                };
                WS.send(JSON.stringify(privateSub));
            }, 1000);
        }
        
        // ==================== MESSAGE HANDLER ====================
        function handleWebSocketMessage(msg) {
            if (msg.type === 'key-auth') {
                if (msg.success) console.log('%cPrivate channels authenticated', 'color:#00ff9d');
                return;
            }
            
            // Ticker
            if (msg.channel === 'v2/ticker' || msg.symbol === symbol && msg.close) {
                lastPrice = currentPrice;
                currentPrice = parseFloat(msg.close || msg.price);
                markPrice = parseFloat(msg.mark_price || markPrice);
                
                document.getElementById('current-price').textContent = currentPrice.toFixed(2);
                document.getElementById('mark-price').textContent = markPrice.toFixed(2);
                
                const change = ((currentPrice - lastPrice) / lastPrice * 100) || 0;
                const changeEl = document.getElementById('price-change');
                changeEl.innerHTML = `
                    <span class="${change >= 0 ? 'text-emerald-400' : 'text-red-400'}">
                        ${change >= 0 ? '▲' : '▼'} ${Math.abs(change).toFixed(2)}%
                    </span>
                    <span class="ml-4 text-zinc-400 font-mono">${msg.volume || 0} ETH</span>
                `;
                
                priceHistory.push({ t: Date.now(), p: currentPrice });
                if (priceHistory.length > 500) priceHistory.shift();
                updatePriceCVDChart();
            }
            
            // Trades → Order Flow + CVD + Volume Profile
            if (msg.type === 'all_trades' || msg.channel === 'all_trades') {
                let trade;
                if (msg.trades) trade = msg.trades[0];
                else trade = msg;
                
                if (!trade) return;
                
                const price = parseFloat(trade.price);
                const size = parseFloat(trade.size);
                const isAggressiveBuy = (trade.buyer_role || trade.side) === 'taker' || trade.side === 'buy';
                
                // CVD
                if (isAggressiveBuy) cvd += size;
                else cvd -= size;
                
                cvdHistory.push({ t: Date.now(), v: cvd });
                if (cvdHistory.length > 300) cvdHistory.shift();
                
                // Volume Profile (price binning – tick size 0.1 for ETH)
                const bin = (Math.round(price * 10) / 10).toFixed(1);
                volumeProfile.set(bin, (volumeProfile.get(bin) || 0) + size);
                
                // Order flow list
                tradesBuffer.unshift({
                    time: new Date().toLocaleTimeString('en-US', {hour12:false, minute:'2-digit', second:'2-digit'}),
                    price: price.toFixed(2),
                    size: size.toFixed(3),
                    side: isAggressiveBuy ? 'BUY 🔥' : 'SELL 🔥',
                    delta: isAggressiveBuy ? '+' + size.toFixed(2) : '-' + size.toFixed(2)
                });
                if (tradesBuffer.length > 30) tradesBuffer.pop();
                
                renderOrderFlow();
                updateVolumeProfileChart();
                
                // Big print alert?
                if (size > 5) {
                    addAlert(`BIG ${isAggressiveBuy ? 'BUY' : 'SELL'} PRINT @ ${price.toFixed(2)} | Size ${size.toFixed(2)} ETH`, isAggressiveBuy ? 'emerald' : 'red');
                }
            }
            
            // L2 Orderbook
            if (msg.type === 'l2_orderbook' && msg.symbol === symbol) {
                bids = msg.buy || [];
                asks = msg.sell || [];
                renderOrderBook();
            }
            
            // Mark price & Funding
            if (msg.channel === 'mark_price') {
                markPrice = parseFloat(msg.mark_price);
                document.getElementById('mark-price').textContent = markPrice.toFixed(2);
            }
            if (msg.channel === 'funding_rate') {
                document.getElementById('funding-rate').innerHTML = 
                    `${parseFloat(msg.funding_rate || 0).toFixed(4)}% <span class="text-[10px]">next in ${msg.next_funding_time ? '8h' : ''}</span>`;
            }
            
            // Private: positions & margins
            if (msg.type === 'positions' || Array.isArray(msg)) {
                const pos = Array.isArray(msg) ? msg.find(p => p.symbol === symbol) : msg;
                if (pos) {
                    position.size = parseFloat(pos.size || 0);
                    position.side = pos.side;
                    position.entry = parseFloat(pos.entry_price || 0);
                    document.getElementById('position-size').innerHTML = 
                        `${position.size > 0 ? '+' : ''}${position.size} <span class="text-xs">${position.side || ''}</span>`;
                }
            }
            if (msg.type === 'margins') {
                const usdtBal = parseFloat(msg.usdt_balance || msg.balance || 0);
                document.getElementById('balance-usdt').textContent = usdtBal.toFixed(2);
            }
        }
        
        // ==================== RENDER FUNCTIONS ====================
        function renderOrderBook() {
            const bidsHTML = bids.slice(0, 12).map(b => 
                `<div class="flex justify-between"><span class="text-emerald-400">${parseFloat(b.limit_price || b[0]).toFixed(2)}</span><span class="font-medium">${parseFloat(b.size || b[1]).toFixed(2)}</span></div>`
            ).join('');
            const asksHTML = asks.slice(0, 12).map(a => 
                `<div class="flex justify-between"><span class="font-medium">${parseFloat(a.size || a[1]).toFixed(2)}</span><span class="text-red-400">${parseFloat(a.limit_price || a[0]).toFixed(2)}</span></div>`
            ).join('');
            
            document.getElementById('bids').innerHTML = bidsHTML || '<div class="text-zinc-500">—</div>';
            document.getElementById('asks').innerHTML = asksHTML || '<div class="text-zinc-500">—</div>';
        }
        
        function renderOrderFlow() {
            const container = document.getElementById('order-flow-list');
            container.innerHTML = tradesBuffer.map(t => `
                <div class="flex justify-between items-center px-3 py-2 rounded-2xl ${t.side.includes('BUY') ? 'bg-emerald-500/10' : 'bg-red-500/10'}">
                    <span class="font-medium">${t.time}</span>
                    <span class="font-semibold ${t.side.includes('BUY') ? 'text-emerald-400' : 'text-red-400'}">${t.side}</span>
                    <span>${t.price}</span>
                    <span class="font-medium">${t.size}</span>
                    <span class="text-xs ${t.delta.startsWith('+') ? 'text-emerald-400' : 'text-red-400'}">${t.delta}</span>
                </div>
            `).join('');
        }
        
        function updateVolumeProfileChart() {
            const sorted = Array.from(volumeProfile.entries())
                .sort((a, b) => parseFloat(a[0]) - parseFloat(b[0]));
            
            const prices = sorted.map(i => i[0]);
            const vols = sorted.map(i => i[1]);
            
            const ctx = document.getElementById('volumeProfileChart');
            if (vpChartInstance) vpChartInstance.destroy();
            
            vpChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: prices,
                    datasets: [{
                        label: 'Volume',
                        data: vols,
                        backgroundColor: '#00ff9d',
                        borderColor: '#00ff9d',
                        borderWidth: 1,
                        barThickness: 8
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { x: { display: false }, y: { ticks: { color: '#888', font: { size: 10 } } } },
                    plugins: { legend: { display: false } }
                }
            });
            
            // Show key LVN / POC levels
            const totalVol = vols.reduce((a,b)=>a+b,0);
            const pocIdx = vols.indexOf(Math.max(...vols));
            const poc = prices[pocIdx];
            
            document.getElementById('vp-levels').innerHTML = `
                <div class="bg-emerald-400/10 rounded-2xl p-2 text-center"><span class="text-emerald-400">POC</span><br><span class="font-mono text-lg">${poc}</span></div>
                <div class="text-center"><span class="text-amber-400">LVN (low)</span><br><span class="font-mono text-lg">${prices[0]}</span></div>
                <div class="text-center"><span class="text-amber-400">LVN (high)</span><br><span class="font-mono text-lg">${prices[prices.length-1]}</span></div>
            `;
        }
        
        function updatePriceCVDChart() {
            const ctx = document.getElementById('priceCVDChart');
            if (priceChartInstance) priceChartInstance.destroy();
            
            const labels = priceHistory.map((_, i) => i);
            
            priceChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Price',
                            data: priceHistory.map(p => p.p),
                            borderColor: '#fff',
                            borderWidth: 2.5,
                            tension: 0.1,
                            yAxisID: 'y'
                        },
                        {
                            label: 'CVD',
                            data: cvdHistory.map(c => c.v),
                            borderColor: '#00ff9d',
                            borderWidth: 2,
                            tension: 0.3,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { intersect: false },
                    scales: {
                        y: { type: 'linear', position: 'left', grid: { color: '#222' } },
                        y1: { type: 'linear', position: 'right', grid: { drawOnChartArea: false } }
                    },
                    plugins: { legend: { display: true, position: 'top' } }
                }
            });
        }
        
        function addAlert(text, color) {
            const log = document.getElementById('alert-log');
            const entry = document.createElement('div');
            entry.className = `flex items-center gap-x-3 px-4 py-2 rounded-2xl mb-1 ${color === 'emerald' ? 'bg-emerald-400/10 text-emerald-400' : 'bg-red-400/10 text-red-400'}`;
            entry.innerHTML = `<i class="fa-solid fa-bell"></i> <span class="flex-1">${text}</span> <span class="text-[10px] font-mono">${new Date().toLocaleTimeString()}</span>`;
            log.prepend(entry);
            if (log.children.length > 8) log.removeChild(log.lastChild);
        }
        
        // ==================== TRADE EXECUTION (LIVE MONEY) ====================
        async function executeTrade(side) {
            const sizeInput = document.getElementById('trade-size').value;
            const orderType = document.getElementById('order-type').value;
            
            if (!API_KEY) {
                alert('Please configure API keys first');
                showApiModal();
                return;
            }
            
            const size = parseFloat(sizeInput);
            if (!size) return;
            
            // Calculate risk-adjusted size (0.5% max)
            const balance = parseFloat(document.getElementById('balance-usdt').textContent) || 1000;
            const riskAmount = balance * (RISK_PERCENT / 100);
            const stopDistance = 15; // approximate ticks away
            const riskPerUnit = stopDistance * 1; // 1 USDT per ETH tick approx
            const maxSize = riskAmount / riskPerUnit;
            
            const finalSize = Math.min(size, maxSize).toFixed(3);
            
            document.getElementById('calc-risk').innerHTML = 
                `<span class="text-emerald-400">${riskAmount.toFixed(2)} USDT</span> risk • size adjusted to ${finalSize} ETH`;
            
            // For demo we show confirmation – in production this would call REST /v2/orders
            console.log(`%c${side.toUpperCase()} ${finalSize} ETH ${orderType.toUpperCase()}`, 'background:#00ff9d;color:black;padding:2px 6px;border-radius:4px');
            
            // Real REST call example (uncomment when ready)
            /*
