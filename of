            console.log(json);
            */
            
            addAlert(`${side.toUpperCase()} ${finalSize} ETH executed`, side === 'buy' ? 'emerald' : 'red');
        }
        
        function confirmAndPlaceOrder() {
            const side = document.querySelector('#order-type').value === 'market' ? 'market' : 'limit'; // dummy
            executeTrade(document.querySelector('button[onclick^="executeTrade"]').textContent.includes('LONG') ? 'buy' : 'sell'); // simplified
        }
        
        // ==================== UTILS ====================
        function resetCVD() { cvd = 0; cvdHistory = []; updatePriceCVDChart(); }
        function resetVP() { volumeProfile.clear(); updateVolumeProfileChart(); }
        
        function changeTimeframe() {
            // In real implementation would resubscribe candlesticks channel
            addAlert('Timeframe changed – rebuilding charts', 'emerald');
        }
        
        function saveApiKeys() {
            API_KEY = document.getElementById('api-key-input').value.trim();
            API_SECRET = document.getElementById('api-secret-input').value.trim();
            localStorage.setItem('deltaApiKey', API_KEY);
            localStorage.setItem('deltaApiSecret', API_SECRET);
            hideApiModal();
            if (WS && WS.readyState === WebSocket.OPEN) authenticatePrivate();
            document.getElementById('api-config-status').innerHTML = '✅ Connected';
            addAlert('API keys saved – private channels active', 'emerald');
        }
        
        function showApiModal() {
            document.getElementById('api-modal').classList.remove('hidden');
            document.getElementById('api-key-input').value = API_KEY;
            document.getElementById('api-secret-input').value = API_SECRET;
        }
        
        function hideApiModal() {
            document.getElementById('api-modal').classList.add('hidden');
        }
        
        // ==================== BOOTSTRAP ====================
        function init() {
            // Tailwind
            tailwind.config = { content: ["*"] };
            
            connectWebSocket();
            
            // Fake initial data for demo
            setTimeout(() => {
                currentPrice = 3124.75;
                markPrice = 3125.10;
                document.getElementById('current-price').textContent = currentPrice;
                document.getElementById('mark-price').textContent = markPrice;
                priceHistory = Array.from({length: 80}, (_, i) => ({ t: Date.now() - (80-i)*60000, p: 3100 + Math.random()*60 }));
                cvdHistory = Array.from({length: 80}, (_, i) => ({ t: Date.now() - (80-i)*60000, v: -200 + i*8 }));
                updatePriceCVDChart();
                
