                volumeProfile.set('3105.0', 124);
                volumeProfile.set('3112.5', 87);
                volumeProfile.set('3120.0', 340);
                volumeProfile.set('3124.0', 210);
                updateVolumeProfileChart();
                
                addAlert('Strategy ready • ETHUSD perpetual loaded from Delta India', 'emerald');
                console.log('%c🚀 Full live-ready dashboard initialized. Use real API keys for money deployment.', 'color:#00ff9d;font-weight:bold');
